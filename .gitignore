# Build output
dist/
.build/

# Dependencies — this project is deliberately zero-dependency, but keep this
# in case that ever changes.
node_modules/

# public/downloads is build output, not source, but both the binary and the
# manifest that describes it are tracked on purpose:
#
#   - The binary is what GitHub Pages serves for the download button. Tracked
#     once so a fresh clone deploys a working download rather than a
#     placeholder. Rebuilds are not byte-reproducible, so each one adds another
#     ~16 MB blob; prefer a release asset if that ever becomes painful.
#   - downloads.json is the single source of truth for the version, size and
#     checksum the site advertises. Without it the page renders "no binaries
#     built yet" even when the binary is sitting right there.
#
# Anything else PyInstaller leaves in the directory is scratch and ignored.
public/downloads/*
!public/downloads/downloads.json
!public/downloads/polyinit-*

# Local overrides
*.log
.DS_Store
